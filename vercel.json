{
  "version": 2,
  "redirects": [
    {
      "source": "/Downloads/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inquiry-app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tsconfig.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/inquiry.ts": {
      "memory": 256,
      "maxDuration": 60,
      "includeFiles": "inquiry-app/{prompts,knowledge}/**"
    }
  },
  "headers": [
    {
      "source": "/inquire/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self' https://heyzine.com https://*.heyzine.com"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
