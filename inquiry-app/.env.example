# For local development: copy to inquiry-app/.env.local and fill in. Never commit real values.
# In production these are set in the disenyodigitals.com Vercel project (see README.md).

# A dedicated "disenyo-inquiry" key, not HQ's. Set a monthly spend limit in the Anthropic console.
ANTHROPIC_API_KEY=

# HQ Supabase project (not the AYA registrations one). Leave both empty to use the in-memory store.
INQUIRY_SUPABASE_URL=
INQUIRY_SUPABASE_ANON_KEY=

# Email alerts (Resend). RESEND_API_KEY is set by the Vercel Resend integration in production.
RESEND_API_KEY=
INQUIRY_ALERT_EMAIL_TO=
# INQUIRY_ALERT_EMAIL_FROM=Disenyo AI Inquiries <alerts@disenyodigitals.com>

# Optional Telegram alerts. With no email or Telegram settings, alerts print to the terminal.
INQUIRY_TELEGRAM_BOT_TOKEN=
INQUIRY_TELEGRAM_CHAT_ID=

# Comma-separated origins allowed to call /api/inquiry. Empty = localhost only.
# Production: https://disenyodigitals.com,https://www.disenyodigitals.com
INQUIRY_ALLOWED_ORIGINS=

# Any long random value, used to hash visitor IPs before storing them.
INQUIRY_IP_HASH_SALT=
