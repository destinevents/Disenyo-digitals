# Copy this file to ".env" and fill in the values.
# The ".env" file is git-ignored and must never be committed.

# ── PayMongo (Dashboard → Developer Tools → API Keys) ────────────
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_PUBLIC_KEY=pk_test_replace_me

# Webhook signing secret (Dashboard → Developer Tools → Webhooks).
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# ── Optional tuning ──────────────────────────────────────────────
PAYMONGO_PAYMENT_METHODS=card,gcash
PAYMONGO_PASS_ON_FEES=false
# APP_BASE_URL=https://your-domain.com

# ── AI inquiry assistant (inquiry-app/README.md) ─────────────────
# Separate names: the inquiry leads live in the HQ Supabase project, not the one above.
ANTHROPIC_API_KEY=replace_with_disenyo_inquiry_key
INQUIRY_SUPABASE_URL=https://your-hq-project.supabase.co
INQUIRY_SUPABASE_ANON_KEY=replace_with_hq_anon_key
INQUIRY_TELEGRAM_BOT_TOKEN=replace_me
INQUIRY_TELEGRAM_CHAT_ID=replace_me
INQUIRY_ALLOWED_ORIGINS=https://disenyodigitals.com,https://www.disenyodigitals.com
INQUIRY_IP_HASH_SALT=replace_with_a_long_random_string
